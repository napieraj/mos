#compdef mos
# GENERATED by scripts/gen-completions.py from the CLI command table (the &mos_cli_command_* array in cli/main.c, each cli/<verb>.c descriptor, cli/tray.c actions).
# Do not edit by hand: run `python3 scripts/gen-completions.py` (or `make completions`) and commit.
# The verb and action lists are derived, so adding a command needs no edit here.

_mos() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a global_opts
    global_opts=(
        '(-i --index)'{-i,--index}'[1-based drive index]:index:'
        '--bsd[BSD form selector]:bsd name:_files -g "disk*" -W /dev'
        '(-j --json)'{-j,--json}'[emit JSON output]'
        '(-h --help)'{-h,--help}'[show help]'
        '--version[show version]'
    )

    _arguments -C \
        "${global_opts[@]}" \
        '1: :->subcmd' \
        '*:: :->args' && return

    case $state in
        subcmd)
            local -a subcommands
            subcommands=(
                'state:Report drive state (default verb)'
                'list:List all drives with their states'
                'watch:Stream state events as NDJSON until SIGINT'
                'metadata:Disc identity record (profile, TOC, volume)'
                'drive:Drive facts (identity, protection, firmware)'
                'features:MMC feature list with current bits'
                'tray:Control the tray (eject, close, lock, unlock)'
                'capacity:Disc capacity (media size + free/append space)'
                'probe:Diagnostic notification stream (mos.probe.v0)'
            )
            _describe -t commands 'mos subcommand' subcommands
            ;;
        args)
            case $line[1] in
                tray)
                    _arguments \
                        "${global_opts[@]}" \
                        '--force[tray eject: ALLOW (unlock) before ejecting]' \
                        '--persistent[tray lock/unlock: Persistent Prevent state]' \
                        '1:action:(eject close lock unlock)'
                    ;;
                probe)
                    _arguments \
                        "${global_opts[@]}" \
                        '--dump[one-shot DiscRecording dictionary capture]'
                    ;;
                *)
                    _arguments "${global_opts[@]}"
                    ;;
            esac
            ;;
    esac
}

_mos "$@"
